# Copy to .env and adjust. NEVER commit .env — it is gitignored.
# These are LOCAL-ONLY container credentials, not production secrets.
# They exist so the estate is reproducible; rotating them means editing this file.

# --- Postgres (ERP + commerce source) ---
POSTGRES_DB=northpeak
POSTGRES_USER=northpeak
POSTGRES_PASSWORD=change_me_locally
POSTGRES_PORT=5432

# --- Debezium replication user ---
# Debezium connects as this user; it needs REPLICATION privilege.
DEBEZIUM_USER=debezium
DEBEZIUM_PASSWORD=change_me_locally

# --- Commerce REST API ---
API_PORT=8000
API_BEARER_TOKEN=local_dev_token_change_me
# Fault injection for testing retry logic: fraction of requests that return 500
API_ERROR_RATE=0.05

# --- SFTP (PIM drop) ---
SFTP_USER=pim
SFTP_PASSWORD=change_me_locally
SFTP_PORT=2222

# --- Kafka / Debezium Connect ---
KAFKA_PORT=9092
CONNECT_PORT=8083
# Kafka log retention. Keep short — local disk fills fast.
KAFKA_LOG_RETENTION_HOURS=6

# --- GCS landing zone ---
GCS_BUCKET=northpeak-landing-CHANGEME
GCS_PREFIX=landing
GCP_PROJECT_ID=northpeak-lakehouse-CHANGEME

# --- Data generation ---
# small | medium | large
DATA_PROFILE=small
GENERATOR_SEED=20260818
